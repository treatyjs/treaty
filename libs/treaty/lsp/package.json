{
  "name": "@treaty/lsp",
  "version": "0.0.1",
  "description": "Plugin-extensible volarjs language server for Treaty authoring formats, backed by the Rust authoring compiler.",
  "author": "Jordan Hall",
  "license": "MIT",
  "type": "module",
  "bin": {
    "treaty-lsp": "./dist/server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./oxlint-plugin": {
      "types": "./dist/oxlint-plugin.d.ts",
      "default": "./dist/oxlint-plugin.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@treaty/authoring-node": "*",
    "@treaty/jsx": "*",
    "@volar/language-core": "~2.4.0",
    "@volar/language-server": "~2.4.0",
    "@volar/typescript": "~2.4.0",
    "volar-service-css": "^0.0.62",
    "volar-service-typescript": "volar-2.4",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8"
  },
  "engines": {
    "node": ">=20.19",
    "bun": ">=1.1"
  }
}
