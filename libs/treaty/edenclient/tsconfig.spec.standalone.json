{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "composite": false,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": ["jest", "node"],
    "lib": ["es2022", "dom"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/typecheck/**/*",
    "src/testing/**/*"
  ]
}
