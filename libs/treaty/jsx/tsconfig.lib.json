{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "composite": false,
    "lib": ["es2022", "dom"],
    "types": []
  },
  "exclude": ["src/**/*.spec.ts", "dist"],
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
