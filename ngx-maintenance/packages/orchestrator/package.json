{
  "name": "@ngx-maintenance/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic end-to-end orchestration: discover -> staleness-decide -> clone+migrate -> open-PR (idempotent) -> 2-week takeover, wiring the four core packages through the github-adapter boundary.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@ngx-maintenance/github-adapter": "workspace:*",
    "@ngx-maintenance/migration-engine": "workspace:*",
    "@ngx-maintenance/registry": "workspace:*",
    "@ngx-maintenance/staleness-detector": "workspace:*",
    "@ngx-maintenance/takeover": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  }
}
