{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../../types", "../../../node_modules/@types"],
    "paths": {
      "@ngx-maintenance/github-adapter": ["../github-adapter/src/index.ts"],
      "@ngx-maintenance/migration-engine": ["../migration-engine/src/index.ts"],
      "@ngx-maintenance/registry": ["../registry/src/index.ts"],
      "@ngx-maintenance/staleness-detector": [
        "../staleness-detector/src/index.ts"
      ],
      "@ngx-maintenance/takeover": ["../takeover/src/index.ts"],
      "@ngx-maintenance/treaty-support": ["../treaty-support/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../types/**/*.d.ts"]
}
