{
  "name": "@ngx-maintenance/github-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The single GitHub, git and process boundary as injectable interfaces (Octokit subset, Shell, repo-ref parsing, PR/issue/clone ops) so all other packages stay fake-testable.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@ngx-maintenance/migration-engine": "workspace:*",
    "@ngx-maintenance/takeover": "workspace:*"
  },
  "devDependencies": {
    "octokit": "*",
    "vitest": "^4.1.7"
  }
}
