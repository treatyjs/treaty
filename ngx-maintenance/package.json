{
  "name": "ngx-maintenance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic (no-AI) GitHub bot that keeps Angular libraries current and takes over unmaintained ones.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "angular-pkgs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "oxlint": "^1.67.0",
    "turbo": "^2.9.16",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.0"
}
