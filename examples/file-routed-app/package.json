{
  "name": "@treaty-examples/file-routed-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "File-system routed Treaty app: a routes/ + api/ tree lowered to Angular lazy routes + Module Federation remotes by the treaty_file_routing convention, wired into a real Vite build via a route-generation step.",
  "scripts": {
    "routes": "node scripts/generate-routes.mjs",
    "verify": "node verify.mjs",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint src scripts *.config.ts",
    "build:vite": "vite build",
    "dev:vite": "vite"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/router": "^21.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@treaty/compiler": "*",
    "@treaty/vite": "*"
  }
}
