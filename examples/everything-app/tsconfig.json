{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": [],
    "paths": {
      "@treaty/compiler": ["../../libs/treaty/compiler/dist/index.d.ts"],
      "@treaty/vite": ["../../libs/treaty/vite/dist/index.d.ts"],
      "@treaty/rspack": ["../../libs/treaty/rspack/dist/index.d.ts"],
      "@treaty/rsbuild": ["../../libs/treaty/rsbuild/dist/index.d.ts"],
      "@treaty/rslib": ["../../libs/treaty/rslib/dist/index.d.ts"],
      "@treaty/module-federation": [
        "../../libs/treaty/module-federation/dist/index.d.ts"
      ],
      "@treaty/federation-deploy": [
        "../../libs/treaty/federation-deploy/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.config.ts",
    "federation/**/*.ts",
    "peers.d.ts"
  ],
  "exclude": ["node_modules"]
}
