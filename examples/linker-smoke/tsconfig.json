{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "e2e.mjs", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "dist-e2e"]
}
