<style>
  button { cursor: pointer; }
  label { display: inline-flex; align-items: center; cursor: pointer; user-select: none; }
  .cm-editor { height: 100%; }
  #loading { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1; display: flex; justify-content: center; align-items: center; }
  #container { display: flex; height: 100vh; }
  #left { display: flex; flex: 1; flex-direction: column; border-right: 1px solid #444; max-width:50%; }
  #editor { flex: 1; overflow-y: auto;}
  #panel { height: 20%; overflow-y: auto; padding: 1em; color: #d1d5da; border-top: 1px solid #444!important; }
  #right { flex: 1; display:flex; flex-direction: column; min-width: 0; }
  .header {  border-bottom: 1px solid #444; display: flex; height: 50px; align-items: stretch; }
  .left-container { padding: .6em; display: flex; align-items: center; justify-content: space-between; }
  .controls { padding: .6em; }
  .controls > div { padding: .2em .5em; display: flex; flex-wrap: wrap; gap: 4px; }
  .controls > div > button { padding: 8px 16px; background-color: #2c3136; color: white; border: 1px solid #444; transition: background-color 0.3s; white-space: nowrap; }
  .controls > div > button:hover { background-color: #444; }
  .controls > div > button.active { background-color: #555; }
  .controls > div > label { margin-right: 4px; }
  .controls label { font-size: 14px; }
  #duration { margin-left: auto; }
  #viewer { flex: 1; overflow-y: auto; }
  #divider { width: 4px; background: #444; }
  #divider:hover { background: #666; cursor: col-resize; }
</style>

import logo from './component/logo.treaty';
import { PluginOutputViewer } from './plugin-output-viewer.component';
import { viewChild, ElementRef, effect, signal } from '@angular/core';
import {EditorView, basicSetup} from "codemirror"
import {javascript} from "@codemirror/lang-javascript"
import { treaty } from './lang-treaty/treatyjs'
import { highlighter } from './utils/highlighter';


const editor = viewChild('editor');
const viewer = viewChild('viewer');

// Which right-hand surface is shown: the live Codegen output (default) or the
// Treaty plugin-output viewer, which compiles one sample per authoring surface
// (.treaty SFC, .tjsx JSX, Angular .ts with a server fn) on mount.
const showPluginOutput = signal(false);
// Show the codegen pane and (re)run codegen against the current editor doc. When
// switching back from the plugin-output pane the `#viewer` element is recreated,
// so defer the codegen pass until after the view updates and the ref resolves.
const showCodegen = () => {
  showPluginOutput.set(false);
  queueMicrotask(() => {
    const el = viewer()?.nativeElement;
    if (el) onClick(el);
  });
};
const showPlugins = () => showPluginOutput.set(true);

const defaultDoc = `
<style>
  .name { display: flex; justify-content: center; cursor: pointer; color: purple; text-decoration: inherit; }
</style>

import { input } from '@angular/core'
import { ExampleComponent } from './example'
const name = input('name')

const example = { hello: 'hello', world: 'world'}
<div>
  <div class="name">{{ name }}</div>
  <ExampleComponent {...example}></ExampleComponent>
</div>
console.log('hello')

`


effect(async () => {
  if (editor()?.nativeElement) {
    window.view = new EditorView({
      doc: await defaultDoc,
      extensions: [
        basicSetup,
        javascript(),
        treaty()
      ],
      lineWrapping: true,
      parent: editor()?.nativeElement
    })
    onClick(viewer());
    window.view.focus();
  }
});


<div id="container">
  <div id="left">
    <div class="header left-container">
      <logo></logo>
      <div>
        <label>
          File
          <select id="file-type-select" style="margin-left: 4px">
            <option value="treat">treaty</option>
            <option disabled value="angular-html">Angular IVY HTML (coming soon)</option>
            <option disabled value="angular">Angular IVY (coming soon)</option>
          </select>
        </label>
      </div>
    </div>
    <div #editor id="editor"></div>
    <div id="panel">
      @if (viewer) {
        <div> LOADING </div>
      }
    </div>
  </div>
  <div id="divider"></div>
  <div #right id="right">
    <div class="header controls">
      <div>
        <button type="button" id="codegen" [class.active]="!showPluginOutput()" (click)="showCodegen()">Codegen</button>
        <button type="button" id="plugin-output" [class.active]="showPluginOutput()" (click)="showPlugins()">Plugin output</button>
      </div>
    </div>
    @if (showPluginOutput()) {
      <div id="plugin-output-panel" style="flex: 1; overflow-y: auto; padding: 1em;">
        <PluginOutputViewer></PluginOutputViewer>
      </div>
    } @else {
      <pre #viewer id="viewer"></pre>
    }
  </div>
</div>

// Live in-browser codegen of arbitrary editor input is intentionally NOT wired to a
// TypeScript compiler: Treaty has ONE compiler — the Rust/OXC `authoring_node` NAPI
// addon — and it runs in Node (build time), not in the browser. The old TS
// `treatyToIvy` fallback has been removed. The "Plugin output" pane shows REAL Rust
// codegen for every authoring surface, precompiled in Node via the addon and shipped
// to the browser as the `virtual:treaty-gallery` data module (see gallery-plugin.ts).
const onClick = async (viwer) => {
  if (!viwer) return;
  const note = [
    '// Live codegen for arbitrary editor input is disabled in the browser.',
    '// Treaty compiles with the Rust/OXC addon (Node-only) — there is no in-browser',
    '// TypeScript compiler. Use the "Plugin output" tab to see real Rust Ivy codegen',
    '// for every authoring surface, compiled at build time through the same addon.',
  ].join('\n');
  const highlighted = highlighter.codeToHtml(note, {
    lang: 'javascript',
    theme: 'github-dark',
  });
  viwer.innerHTML = highlighted;
}